# Conventional Commits are load-bearing here: release-please derives the version and the
# changelog from them. Reject anything that would silently produce no release.
message=$(head -n1 "$1")
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._/-]+\))?!?: .{1,}$'

if printf '%s' "$message" | grep -Eq "$pattern"; then
  exit 0
fi

if printf '%s' "$message" | grep -Eq '^(Merge|Revert) '; then
  exit 0
fi

echo "✗ Commit message must follow Conventional Commits, e.g.:"
echo "    feat(web): add a colour-temperature preset row"
echo "    fix(server): keep group membership when renaming a group"
echo ""
echo "  Got: $message"
exit 1
