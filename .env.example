# Milight Studio configuration.
# Copy to .env for local development, or pass these as environment variables to Docker.
# Every value shown is the default unless noted otherwise.

# ─── The hub ──────────────────────────────────────────────────────────────────────────
# Base URL of your esp8266_milight_hub. This is the one setting you must change.
MILIGHT_HUB_URL=http://milight-hub.local
MILIGHT_HUB_TIMEOUT_MS=5000
MILIGHT_HUB_RETRIES=2
# Minimum gap between requests to the hub. The ESP8266 drops packets when hammered;
# raise this to 80 or 120 if commands go missing while dragging a slider.
MILIGHT_HUB_MIN_GAP_MS=40
# How often to probe the hub for reachability. 0 disables the monitor.
MILIGHT_HUB_POLL_MS=30000

# ─── HTTP ─────────────────────────────────────────────────────────────────────────────
PORT=8080
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info
# Comma-separated list of allowed origins, or * for any.
CORS_ORIGINS=*
# Requests per minute per client once hardening is on. Loopback is always exempt.
RATE_LIMIT_MAX=3000
# Uncomment to require `Authorization: Bearer <token>` on every /api request.
# Minimum 16 characters. Generate one with: openssl rand -hex 24
# API_TOKEN=

# ─── Storage ──────────────────────────────────────────────────────────────────────────
# Lights, groups, scenes and shadow state. Mount this as a volume in Docker.
DATA_DIR=./data

# ─── Web UI ───────────────────────────────────────────────────────────────────────────
SERVE_WEB=true
WEB_ROOT=../web/dist

# ─── Matter bridge (recommended route to Alexa) ───────────────────────────────────────
# Needs a Matter-capable Echo, IPv6 on the LAN, and host networking in Docker.
MATTER_BRIDGE_ENABLED=false
MATTER_BRIDGE_PORT=5540
MATTER_BRIDGE_PASSCODE=20202021
MATTER_BRIDGE_DISCRIMINATOR=3840
MATTER_STORAGE_DIR=./data/matter

# ─── Hue emulation (legacy fallback: on/off and brightness only, no colour) ────────────
# Requires port 80 and host networking. See docs/alexa.md before enabling.
HUE_BRIDGE_ENABLED=false
HUE_BRIDGE_PORT=80
# Leave empty to auto-detect the LAN address advertised to Alexa.
HUE_BRIDGE_ADDRESS=
